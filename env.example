# Every value here is OPTIONAL. The agent runs fully offline with no .env file:
# request classification uses the keyword matcher and every other decision is
# deterministic (0 model calls).
#
# To enable the model path:
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (macOS / Linux)
# Keep .env out of git and out of code.zip. Real environment variables always
# win over values in this file.

# --- provider ---------------------------------------------------------------
# auto      -> anthropic if ANTHROPIC_API_KEY is set, else openai if
#              OPENAI_API_KEY is set, else none (default)
# none      -> offline: never call a model, even if a key is set
# anthropic | openai -> force that provider (offline if its key is missing)
AUDIT_LLM_PROVIDER=auto

# Model override. Empty means the provider default
# (claude-haiku-5-5 for anthropic, gpt-4o-mini for openai).
AUDIT_MODEL=

# Per-call timeout in seconds, and completion token limit.
AUDIT_LLM_TIMEOUT=60
AUDIT_MAX_TOKENS=1024

# USD per 1M tokens. Only needed for a model that is not in PRICES in
# code/audit/llm.py; otherwise the usage report cost is "unknown".
AUDIT_PRICE_INPUT=
AUDIT_PRICE_OUTPUT=

# --- credentials ------------------------------------------------------------
# Read from the environment only. Never written to the cache, the usage log or
# the output. Leave empty to run entirely offline.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
